{
  "name": "@inneranimalmedia/theme-iasf",
  "version": "2.6.19",
  "description": "IASF \u2014 stock Inner Animal Storefront theme pack (normalized from studio-cms-editor harvest).",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./content": "./src/content.js",
    "./tokens": "./src/tokens.js",
    "./styles/storefront.css": "./src/styles/storefront.css",
    "./favicon.svg": "./src/favicon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "site",
    "prebuild.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "FSL-1.1-MIT",
  "agentsam": {
    "kind": "theme",
    "slug": "iasf",
    "canonicalId": "iasf",
    "installable": true,
    "stock": true,
    "icon": "theme",
    "lineage": "iasf",
    "family": "editorial-commerce",
    "normalization": "promoted_stock",
    "donor": "studio-cms-editor/theme_layout_donor",
    "aliases": [
      "inneranimals-site",
      "theme-inneranimals-site",
      "inner-animals-storefront"
    ],
    "store": {
      "name": "Evolution",
      "summary": "A striking editorial apparel storefront with product, collection, journal and story layouts.",
      "category": "Commerce",
      "industries": [
        "Retail",
        "Apparel",
        "Lifestyle"
      ],
      "catalogSizes": [
        "Small catalog",
        "Medium catalog"
      ],
      "tags": [
        "Products",
        "Collections",
        "Editorial",
        "Archetypes",
        "Responsive"
      ],
      "pages": [
        "Home",
        "Shop",
        "Product",
        "Collection",
        "Journal",
        "Story",
        "Checkout preview"
      ],
      "features": [
        "Responsive storefront",
        "Product discovery",
        "Search",
        "Cart preview",
        "CMS starter manifest"
      ],
      "colorway": "paper",
      "cardImage": "/previews/iasf.webp",
      "sortOrder": 8,
      "priceUsd": 0,
      "previewBuild": "package"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/inneranimalmedia-theme-store.git",
    "directory": "packages/theme-iasf"
  }
}
