{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inneranimalmedia-theme-store",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/theme-packages/*"]
  },
  "r2_buckets": [
    {
      "binding": "THEME_PACKAGES",
      "bucket_name": "theme-store"
    }
  ],
  "observability": { "enabled": true }
}
