{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inneranimalmedia-theme-store",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/theme-packages/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "THEME_PACKAGES",
      "bucket_name": "theme-store"
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inneranimalmedia-business",
      "database_id": "cf87b717-d4e2-4cf8-bab0-a81268e32d49"
    }
  ]
}
