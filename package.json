{
  "name": "@inneranimalmedia/theme-store",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical InnerAnimalMedia theme marketplace, Cloudflare Worker and R2 artifact delivery",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "vite preview",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "publish:previews": "node scripts/publish-theme-packages.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "publish:previews:deploy": "node scripts/publish-theme-packages.mjs --deploy",
    "catalog": "node scripts/build-catalog.mjs",
    "dev": "npm run catalog && vite",
    "check": "npm run catalog && tsc --noEmit",
    "build": "npm run catalog && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "publish:site": "node scripts/publish-site.mjs --database inneranimalmedia-business && node scripts/publish-footer.mjs --database inneranimalmedia-business",
    "footer:seed": "node scripts/seed-footer.mjs --database inneranimalmedia-business",
    "publish:footer": "node scripts/publish-footer.mjs --database inneranimalmedia-business",
    "publish:install-projects": "node scripts/publish-install-projects.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.1.0",
    "wrangler": "^4.0.0"
  },
  "bin": {
    "iam-theme": "./bin/iam-theme.mjs"
  }
}
