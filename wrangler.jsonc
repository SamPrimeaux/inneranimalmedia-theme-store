{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inneranimalmedia-theme-store",
  "main": "src/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/theme-packages/*",
      "/themes/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "THEME_PACKAGES",
      "bucket_name": "theme-store"
    }
  ],
  "routes": [
    {
      "pattern": "themes.inneranimalmedia.com",
      "zone_name": "inneranimalmedia.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
