{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inneranimalmedia-theme-store",
  "main": "src/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-28",
  "vars": {
    "THEME_INSTALLER_URL": "https://agentsam.inneranimalmedia.com/sites"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/studio",
      "/studio/*",
      "/app-embeds",
      "/app-embeds/*",
      "/theme-packages/*",
      "/themes/*",
      "/site-media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inneranimalmedia-business",
      "database_id": "cf87b717-d4e2-4cf8-bab0-a81268e32d49"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THEME_PACKAGES",
      "bucket_name": "theme-store"
    }
  ],
  "routes": [
    {
      "pattern": "themes.inneranimalmedia.com",
      "zone_name": "inneranimalmedia.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
